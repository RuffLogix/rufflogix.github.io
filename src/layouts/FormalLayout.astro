---
import FormalNavbar from "../components/FormalNavbar.astro";
import FormalFooter from "../components/FormalFooter.astro";
import "../styles/formal.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RuffLogix: Research-Driven Software Engineering",
  description = "Software engineer, AI researcher, and systems programmer building intelligent systems and experimental technology.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts are self-hosted (see formal.css). Only the faces that paint above
         the fold on every page are preloaded: the sans at 500 and 700 for the
         headline and nav, the mono at 500 for the eyebrow labels. The rest are
         discovered from the stylesheet as usual. -->
    <link
      rel="preload"
      href="/fonts/jakarta-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jakarta-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#0C0C0E" />

    <!-- Critical CSS to prevent flash. Must match --bg/--text-1 exactly. -->
    <style is:inline>
      html { background: #0C0C0E; color: #F2F2F2; }
      html[data-theme="light"] { background: #FFFFFF; color: #111111; }
    </style>

    <!-- Apply saved theme immediately, before paint -->
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
        else if (window.matchMedia('(prefers-color-scheme: light)').matches)
          document.documentElement.setAttribute('data-theme', 'light');
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <FormalNavbar />

    <main id="main" tabindex="-1" style="padding-top: var(--nav-h);">
      <slot />
    </main>

    <FormalFooter />
  </body>

  <script>
    /* ── Theme manager ── */
    const html = document.documentElement;
    const btn  = document.getElementById('theme-toggle');
    let theme  = (localStorage.getItem('theme') as 'dark' | 'light') ||
                 (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    const apply = (t: 'dark' | 'light') => {
      html.setAttribute('data-theme', t);
      localStorage.setItem('theme', t);
      theme = t;

      // Announce the destination, not the current state — that's what the click does
      const next = t === 'dark' ? 'light' : 'dark';
      const label = `Switch to ${next} theme`;
      btn?.setAttribute('aria-pressed', String(t === 'light'));
      btn?.setAttribute('aria-label', label);
      btn?.setAttribute('title', label);

      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', t === 'dark' ? '#0C0C0E' : '#FFFFFF');
    };
    apply(theme);
    btn?.addEventListener('click', () => apply(theme === 'dark' ? 'light' : 'dark'));

    /* ── Frosted nav on scroll ── */
    const nav = document.getElementById('nav');
    const onScroll = () => {
      if (window.scrollY > 16) nav?.classList.add('nav-solid');
      else nav?.classList.remove('nav-solid');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ── Scroll reveal ── */
    const io = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</html>
