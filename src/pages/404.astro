---
import FormalLayout from "../layouts/FormalLayout.astro";

const suggestions = [
  { href: "/projects", label: "Work" },
  { href: "/publications", label: "Publications" },
  { href: "/articles", label: "Writing" },
  { href: "/about", label: "About" },
];
---

<FormalLayout
  title="404 — RuffLogix"
  description="The page you were looking for doesn't exist."
>
  <section class="nf">
    <div class="nf-ambient" aria-hidden="true">
      <div class="nf-glow"></div>
    </div>

    <div class="nf-inner page-wrap">
      <p class="label hero-anim ha1" style="letter-spacing: 0.18em;">
        Error 404
      </p>

      <h1 class="nf-code hero-anim ha2">404</h1>

      <p class="nf-title hero-anim ha3">This page doesn't exist.</p>

      <p class="nf-sub hero-anim ha4">
        The link may be outdated, or the page has moved. Everything else is
        still where you left it.
      </p>

      <div class="nf-cta hero-anim ha4">
        <a href="/" class="btn btn-solid">
          Back home
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/projects" class="btn btn-ghost">View work</a>
      </div>

      <nav class="nf-links hero-anim ha5" aria-label="Suggested pages">
        <span class="label">Or try</span>
        {
          suggestions.map(({ href, label }) => (
            <a href={href} class="nf-link">
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</FormalLayout>

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .nf-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .nf-glow {
    position: absolute;
    top: -15%;
    left: 20%;
    width: 55vw;
    height: 55vw;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    background: radial-gradient(ellipse, var(--glow-1) 0%, transparent 70%);
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 0.5rem + 16vw, 13rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--text-1);
    margin: 1.5rem 0 1.75rem;
  }

  .nf-title {
    font-size: clamp(1.35rem, 0.6rem + 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin-bottom: 0.85rem;
  }

  .nf-sub {
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 46ch;
    margin-bottom: 2.25rem;
  }

  .nf-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .nf-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .nf-link {
    font-size: 0.85rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  .nf-link:hover {
    color: var(--text-1);
  }

  @media (max-width: 640px) {
    .nf-links {
      margin-top: 2.5rem;
    }
  }
</style>
