---
import FormalLayout from "../layouts/FormalLayout.astro";
import { projectInformation } from "../constants/project.constant.ts";
import { publicationInformation } from "../constants/publication.constant.ts";
import AffiliationStrip from "../components/AffiliationStrip.astro";
import { projectHue } from "../utils/hue.ts";
import { decodeEntities, stripEmDashes } from "../utils/html.ts";

const MEDIUM_URL =
  "https://api.rss2json.com/v1/api.json?rss_url=https://medium.com/feed/@rufflogix";

interface MediumPost {
  title: string;
  pubDate: string;
  guid: string;
  description: string;
}

function excerpt(html: string, max = 130) {
  const t = stripEmDashes(decodeEntities(html.replace(/<[^>]*>/g, "")))
    .replace(/\s+/g, " ")
    .trim();
  return t.length > max ? t.slice(0, max) + "…" : t;
}

function fmtDate(s: string) {
  return new Date(s).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

let posts: MediumPost[] = [];
try {
  const r = await fetch(MEDIUM_URL);
  const d = await r.json();
  posts = d.items?.slice(0, 3) || [];
} catch {
  /* silent */
}

const featured = projectInformation.slice(0, 3);
const recentPublications = publicationInformation.slice(0, 3);

// Named after the work that actually exists — the first three map to the
// publication list, the rest to shipped engineering.
const focusAreas = [
  "Computer Graphics",
  "Medical Imaging AI",
  "Formal Verification",
  "LLM Systems",
  "Distributed Backends",
  "High-Performance Computing",
];

const philosophy = [
  {
    word: "Reproducible",
    desc: "A result that only runs on the author's machine, on the author's split, is not a result.",
  },
  {
    word: "Verified",
    desc: "Formal models where tests can't reach. Concurrent pipelines deadlock in states no unit test enumerates.",
  },
  {
    word: "Measured",
    desc: "Baselines before models. Sometimes copying the last frame beats the network you spent a month training.",
  },
  {
    word: "Deployed",
    desc: "The paper and the running system are the same project, finished at different times.",
  },
];
---

<FormalLayout>
  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-inner page-wrap">
      <p class="hero-label label hero-anim ha1">RuffLogix</p>

      <h1 class="hero-headline hero-anim ha2">
        Research&#8209;Driven<br />
        <span class="hero-headline-dim">Software Engineering</span>
      </h1>

      <p class="hero-sub hero-anim ha3">
        Published research in computer graphics, medical imaging AI,<br
          class="br-lg"
        />
        and formal verification, plus the systems that put it into production.
      </p>

      <div class="hero-cta hero-anim ha4">
        <a href="/projects" class="btn btn-solid">
          View Projects
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/publications" class="btn btn-ghost">
          Publications
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h7a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5H4z"></path>
            <path d="M20 4h-7a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5H20z"></path>
          </svg>
        </a>
        <a
          href="https://github.com/RuffLogix"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          GitHub
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline><line
              x1="10"
              y1="14"
              x2="21"
              y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Scroll cue -->
      <div class="hero-scroll hero-anim ha5" aria-hidden="true">
        <div class="scroll-line"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ABOUT STRIP
       ═══════════════════════════════════════════ -->
  <section class="about-strip page-wrap">
    <div class="about-grid">
      <div class="about-bio reveal">
        <p class="label-strong" style="margin-bottom: 1.25rem;">About</p>
        <p class="about-text">
          Software engineer and AI researcher based in Bangkok. Currently
          full-time at <strong>Khui AI</strong> on LLM training, fine-tuning,
          and deployment, alongside an AI engineering apprenticeship at <strong
            >KBTG</strong
          >. Previously at Agoda, bridging LLMs and Temporal.io through MCP, plus
          LINE MAN Wongnai, AIMET, and Looloo Technology, across federated
          learning, speech AI, backend systems, and smart contracts.
        </p>
        <p class="about-text" style="margin-top: 0.9rem;">
          Computer Engineering student at <strong
            >Chulalongkorn University</strong
          >, publishing on computer graphics, medical imaging AI, and formal
          verification: {publicationInformation.length} papers in <strong
            >IEEE Access</strong
          >, <strong>JCSSE</strong>, and on <strong>arXiv</strong>. Super AI
          Engineer Season 5 · iGEM 2024 Silver · TOI Thailand 2020/2021.
        </p>
        <a href="/about" class="about-more">
          Full background
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="focus-areas reveal d2">
        <p class="label-strong" style="margin-bottom: 1.25rem;">Focus Areas</p>
        <div class="focus-tags">
          {
            focusAreas.map((area) => <span class="tag">{area}</span>)
          }
        </div>
      </div>
    </div>
  </section>

  <AffiliationStrip />

  <!-- ═══════════════════════════════════════════
       SELECTED WORK
       ═══════════════════════════════════════════ -->
  <section class="work-section page-wrap">
    <div class="section-header reveal">
      <p class="label-strong">Selected Work</p>
      <a href="/projects" class="section-link">
        All projects
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line><polyline
            points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="bento-grid">
      {
        featured.map((p, i) => (
          <article
            class:list={[
              "bento-card card reveal",
              { "bento-wide": i === 0 },
              `d${i + 1}`,
            ]}
            data-hue={projectHue(p.category)}
          >
            <div class="bento-top">
              <span class="bento-cat label">{p.category}</span>
              <span class="bento-date label">{p.date}</span>
              {p.status && <span class="bento-status">{p.status}</span>}
            </div>
            <h3 class="bento-title">{p.title}</h3>
            <p class="bento-desc">{p.description}</p>
            <div class="bento-tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <div class="bento-actions">
              {p.githubLinks?.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bento-link"
                >
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                  </svg>
                  {link.label}
                </a>
              ))}
              {p.articleLink && (
                <a
                  href={p.articleLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bento-link"
                >
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  Article
                </a>
              )}
              {p.infoLink && (
                <a
                  href={p.infoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bento-link"
                >
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  Live
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SELECTED RESEARCH
       ═══════════════════════════════════════════ -->
  <section class="research-section page-wrap">
    <div class="section-header reveal">
      <p class="label-strong">Selected Research</p>
      <a href="/publications" class="section-link">
        All publications
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line><polyline
            points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ol class="research-list">
      {
        recentPublications.map((p, i) => (
          <li
            class:list={["research-row reveal", `d${i + 1}`]}
            data-hue="research"
          >
            <a
              href={p.doiLink ?? "/publications"}
              target={p.doiLink ? "_blank" : undefined}
              rel={p.doiLink ? "noopener noreferrer" : undefined}
              class="research-link"
            >
              <span class="research-meta label">
                <span class="research-type">{p.type}</span>
                <span class="research-sep" aria-hidden="true">
                  /
                </span>
                {p.venue}
                <span class="research-sep" aria-hidden="true">
                  /
                </span>
                {p.date}
              </span>
              <h3 class="research-title">{p.title}</h3>
              <p class="research-authors">
                {p.authors.length > 3
                  ? `${p.authors[0]} et al.`
                  : p.authors.join(", ")}
              </p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ═══════════════════════════════════════════
       RESEARCH PHILOSOPHY
       ═══════════════════════════════════════════ -->
  <section class="philosophy-section page-wrap">
    <p class="label-strong reveal" style="margin-bottom: 3rem;">
      Research Philosophy
    </p>
    <div class="philosophy-grid">
      {
        philosophy.map(({ word, desc }, i) => (
          <div class:list={["phil-item reveal", `d${i + 1}`]}>
            <h3 class="phil-word">{word}</h3>
            <p class="phil-desc">{desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Cinematic quote -->
    <blockquote class="phil-quote reveal d4">
      <span class="phil-quote-mark">"</span>
      A proof you can check and an experiment you can rerun:<br />
      <em>the same discipline, applied twice.</em>
    </blockquote>
  </section>

  <!-- ═══════════════════════════════════════════
       WRITING
       ═══════════════════════════════════════════ -->
  {
    posts.length > 0 && (
      <section class="writing-section page-wrap">
        <div class="section-header reveal">
          <p class="label-strong">Writing</p>
          <a href="/articles" class="section-link">
            All posts
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </>
            </svg>
          </a>
        </div>

        <div class="posts-list">
          {posts.map((post, i) => (
            <a
              href={post.guid}
              target="_blank"
              rel="noopener noreferrer"
              class:list={["post-row reveal", `d${i + 1}`]}
            >
              <div class="post-row-left">
                <span class="post-date label">{fmtDate(post.pubDate)}</span>
                <h3 class="post-title">{stripEmDashes(decodeEntities(post.title))}</h3>
                <p class="post-excerpt">{excerpt(post.description)}</p>
              </div>
              <svg
                class="post-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )
  }
</FormalLayout>

<style>
  /* ── HERO ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    overflow: hidden;
  }


  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 6rem;
    padding-bottom: 6rem;
    width: 100%;
  }

  .hero-label {
    margin-bottom: 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--text-2); /* stronger than default text-3 for hero identity */
  }

  .hero-headline {
    /* One continuous ramp. A separate mobile clamp used to collide with this
       one at 640px and snap the headline down ~16px. The 6.25rem ceiling is
       the largest size that still keeps "Software Engineering" on one line
       inside the 1032px content column. */
    font-size: clamp(2.1rem, 0.3rem + 7.7vw, 6.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--text-1);
    margin-bottom: 2rem;
  }
  .hero-headline-dim {
    color: var(--text-2);
    font-weight: 500;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-scroll {
    margin-top: 5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .scroll-line {
    width: 32px;
    height: 1px;
    background: var(--border-hover);
    position: relative;
    overflow: hidden;
  }
  /* Animating `left` relayouts the hero on every frame of a loop that never
     stops; the same travel as a transform stays on the compositor. */
  .scroll-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--text-2);
    will-change: transform;
    animation: scan 2.4s ease-in-out infinite;
  }
  @keyframes scan {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after {
      animation: none;
    }
  }

  /* ── ABOUT STRIP ──────────────────────────────────────────── */
  .about-strip {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-text {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.75;
  }
  .about-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--text-3);
    transition: color var(--t-fast);
  }
  .about-more:hover {
    color: var(--text-1);
  }
  .about-more svg {
    transition: transform var(--t-fast);
  }
  .about-more:hover svg {
    transform: translateX(3px);
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── WORK ─────────────────────────────────────────────────── */
  .work-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  .section-link:hover {
    color: var(--text-1);
  }
  .section-link svg {
    transition: transform var(--t-fast);
  }
  .section-link:hover svg {
    transform: translateX(3px);
  }

  /* Bento grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .bento-wide {
    grid-column: 1 / -1;
  }

  .bento-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .bento-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bento-cat {
    color: var(--hue);
    font-weight: 500;
  }
  .bento-date {
    color: var(--text-2);
    margin-left: auto;
  }
  .bento-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--hue);
    background: color-mix(in srgb, var(--hue) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--hue) 30%, transparent);
  }
  .bento-status::before {
    content: "";
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--hue);
    animation: bento-pulse 1.8s ease-in-out infinite;
  }
  @keyframes bento-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .bento-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    line-height: 1.35;
  }
  .bento-wide .bento-title {
    font-size: 1.4rem;
  }

  .bento-desc {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.7;
    flex: 1;
  }
  .bento-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .bento-actions {
    display: flex;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
  }
  .bento-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  .bento-link:hover {
    color: var(--text-1);
  }

  /* ── SELECTED RESEARCH ────────────────────────────────────── */
  .research-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
  }
  .research-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .research-row {
    border-bottom: 1px solid var(--border);
  }
  .research-link {
    display: block;
    padding: 1.4rem 0;
  }
  .research-meta {
    display: block;
    color: var(--text-3);
    margin-bottom: 0.5rem;
  }
  .research-type {
    color: var(--hue);
  }
  .research-sep {
    margin: 0 0.5rem;
    color: var(--border-hover);
  }
  .research-title {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text-1);
