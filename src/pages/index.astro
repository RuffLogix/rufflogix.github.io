---
import FormalLayout from "../layouts/FormalLayout.astro";
import { projectInformation } from "../constants/project.constant.ts";
import { publicationInformation } from "../constants/publication.constant.ts";
import AffiliationStrip from "../components/AffiliationStrip.astro";
import { projectHue } from "../utils/hue.ts";
import {
  projectLinks,
  projectShortDate,
  projectSummary,
} from "../utils/project.ts";
import { getPosts, postDate, postExcerpt, postTitle } from "../utils/medium.ts";

const posts = (await getPosts()).slice(0, 3);

// Conference venues are full sentences ending in the acronym people actually
// cite; spelled out in an uppercase meta line they wrap to two rows.
const shortVenue = (venue: string, type: string) =>
  type === "Conference Paper"
    ? (venue.match(/\(([^()]+)\)\s*$/)?.[1] ?? venue)
    : venue;

const featured = projectInformation.slice(0, 3);
const recentPublications = publicationInformation.slice(0, 3);

// Named after the work that actually exists — the first three map to the
// publication list, the rest to shipped engineering.
const focusAreas = [
  "Computer Graphics",
  "Medical Imaging AI",
  "Formal Verification",
  "LLM Systems",
  "Distributed Backends",
  "High-Performance Computing",
];

const philosophy = [
  {
    word: "Reproducible",
    desc: "A result that only runs on the author's machine, on the author's split, is not a result.",
  },
  {
    word: "Verified",
    desc: "Formal models where tests can't reach. Concurrent pipelines deadlock in states no unit test enumerates.",
  },
  {
    word: "Measured",
    desc: "Baselines before models. Sometimes copying the last frame beats the network you spent a month training.",
  },
  {
    word: "Deployed",
    desc: "The paper and the running system are the same project, finished at different times.",
  },
];
---

<FormalLayout>
  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-inner page-wrap">
      <p class="hero-label label hero-anim ha1">RuffLogix</p>

      <h1 class="hero-headline hero-anim ha2">
        Research&#8209;Driven<br />
        <span class="hero-headline-dim">Software Engineering</span>
      </h1>

      <p class="hero-sub hero-anim ha3">
        I build AI systems and prove they're reliable.<br class="br-lg" />
        Published research in computer graphics, medical imaging AI,<br
          class="br-lg"
        />
        and formal verification, plus the systems that put it into production.
      </p>

      <div class="hero-cta hero-anim ha4">
        <a href="/projects" class="btn btn-solid">
          View Projects
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/publications" class="btn btn-ghost">
          Publications
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h7a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5H4z"></path>
            <path d="M20 4h-7a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5H20z"></path>
          </svg>
        </a>
        <a
          href="https://github.com/RuffLogix"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          GitHub
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline><line
              x1="10"
              y1="14"
              x2="21"
              y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Scroll cue -->
      <div class="hero-scroll hero-anim ha5" aria-hidden="true">
        <div class="scroll-line"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ABOUT STRIP
       ═══════════════════════════════════════════ -->
  <section class="about-strip page-wrap">
    <div class="about-grid">
      <div class="about-bio reveal">
        <p class="label-strong" style="margin-bottom: 1.25rem;">About</p>
        <p class="about-text">
          Software engineer and AI researcher based in Bangkok. Currently
          full-time at <strong>Khui AI</strong> on LLM training, fine-tuning,
          and deployment, alongside an AI engineering apprenticeship at <strong
            >KBTG</strong
          >. Previously at Agoda, bridging LLMs and Temporal.io through MCP, plus
          LINE MAN Wongnai, AIMET, and Looloo Technology, across federated
          learning, speech AI, backend systems, and smart contracts.
        </p>
        <p class="about-text" style="margin-top: 0.9rem;">
          Computer Engineering student at <strong
            >Chulalongkorn University</strong
          >, publishing on computer graphics, medical imaging AI, and formal
          verification: {publicationInformation.length} papers in <strong
            >IEEE Access</strong
          >, <strong>JCSSE</strong>, <strong>ICSEC</strong>, <strong>iSAI-NLP</strong>, and on
          <strong>arXiv</strong>. Undergraduate researcher in the <a
            href="https://www.cp.eng.chula.ac.th/~pizzanu/members.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link">Computer Graphics Laboratory</a
          >, advised by <a
            href="https://www.cp.eng.chula.ac.th/~pizzanu/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link">Assoc. Prof. Pizzanu Kanongchaiyos</a
          >, working on
          learning-based visual computing. Super AI
          Engineer Season 5 · iGEM 2024 Silver · TOI Thailand 2020/2021.
        </p>
        <a href="/about" class="about-more">
          Full background
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="focus-areas reveal d2">
        <p class="label-strong" style="margin-bottom: 1.25rem;">Focus Areas</p>
        <div class="focus-tags">
          {
            focusAreas.map((area) => <span class="tag">{area}</span>)
          }
        </div>
      </div>
    </div>
  </section>

  <AffiliationStrip />

  <!-- ═══════════════════════════════════════════
       SELECTED WORK
       ═══════════════════════════════════════════ -->
  <section class="work-section page-wrap">
    <div class="section-header reveal">
      <p class="label-strong">Selected Work</p>
      <a href="/projects" class="section-link">
        All projects
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line><polyline
            points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="work-grid">
      {
        featured.map((p) => {
          const links = projectLinks(p);
          return (
            <article class="work-card card reveal" data-hue={projectHue(p.category)}>
              <p class="work-meta">
                <span class="work-cat label">{p.category}</span>
                <span class="label">{projectShortDate(p)}</span>
              </p>
              <h3 class="work-title">{p.title}</h3>
              <p class="work-summary">{projectSummary(p)}</p>
              {links.length > 0 && (
                <p class="work-links">
                  {links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-link"
                    >
                      {link.label}
                    </a>
                  ))}
                </p>
              )}
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SELECTED RESEARCH
       ═══════════════════════════════════════════ -->
  <section class="research-section page-wrap">
    <div class="section-header reveal">
      <p class="label-strong">Selected Research</p>
      <a href="/publications" class="section-link">
        All publications
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line><polyline
            points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ol class="research-list">
      {
        recentPublications.map((p, i) => (
          <li
            class:list={["research-row reveal", `d${i + 1}`]}
            data-hue="research"
          >
            <a
              href={p.doiLink ?? "/publications"}
              target={p.doiLink ? "_blank" : undefined}
              rel={p.doiLink ? "noopener noreferrer" : undefined}
              class="research-link"
            >
              <span class="research-meta label">
                <span class="research-type">
                  {p.status === "accepted" ? `${p.type} (Accepted)` : p.type}
                </span>
                <span class="research-sep" aria-hidden="true">
                  /
                </span>
                {shortVenue(p.venue, p.type)}
                <span class="research-sep" aria-hidden="true">
                  /
                </span>
                {p.date}
              </span>
              <h3 class="research-title">{p.title}</h3>
              <p class="research-authors">
                {p.authors.length > 3
                  ? `${p.authors[0]} et al.`
                  : p.authors.join(", ")}
              </p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ═══════════════════════════════════════════
       RESEARCH PHILOSOPHY
       ═══════════════════════════════════════════ -->
  <section class="philosophy-section page-wrap">
    <p class="label-strong reveal" style="margin-bottom: 3rem;">
      Research Philosophy
    </p>
    <div class="philosophy-grid">
      {
        philosophy.map(({ word, desc }, i) => (
          <div class:list={["phil-item reveal", `d${i + 1}`]}>
            <h3 class="phil-word">{word}</h3>
            <p class="phil-desc">{desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Cinematic quote -->
    <blockquote class="phil-quote reveal d4">
      <span class="phil-quote-mark">"</span>
      A proof you can check and an experiment you can rerun:<br />
      <em>the same discipline, applied twice.</em>
    </blockquote>
  </section>

  <!-- ═══════════════════════════════════════════
       WRITING
       ═══════════════════════════════════════════ -->
  {
    posts.length > 0 && (
      <section class="writing-section page-wrap">
        <div class="section-header reveal">
          <p class="label-strong">Writing</p>
          <a href="/articles" class="section-link">
            All posts
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </>
            </svg>
          </a>
        </div>

        <div class="posts-list">
          {posts.map((post, i) => (
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={["post-row reveal", `d${i + 1}`]}
            >
              <div class="post-row-left">
                <span class="post-date label">{postDate(post)}</span>
                <h3 class="post-title">{postTitle(post)}</h3>
                <p class="post-excerpt">{postExcerpt(post, 130)}</p>
              </div>
              <svg
                class="post-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )
  }
</FormalLayout>

<style>
  /* Cards and pill tags are this page's look; the inner pages stay on hairlines */
  .card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    transition:
      border-color var(--t-mid) var(--expo),
      transform var(--t-mid) var(--expo),
      box-shadow var(--t-mid) var(--expo);
  }
  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border-hover);
    background: var(--surface);
    color: var(--text-2);
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    overflow: hidden;
  }


  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 6rem;
    padding-bottom: 6rem;
    width: 100%;
  }

  .hero-label {
    margin-bottom: 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--text-2); /* stronger than default text-3 for hero identity */
  }

  .hero-headline {
    /* One continuous ramp. A separate mobile clamp used to collide with this
       one at 640px and snap the headline down ~16px. The 6.25rem ceiling is
       the largest size that still keeps "Software Engineering" on one line
       inside the 1032px content column. */
    font-size: clamp(2.1rem, 0.3rem + 7.7vw, 6.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--text-1);
    margin-bottom: 2rem;
  }
  .hero-headline-dim {
    color: var(--text-2);
    font-weight: 500;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-scroll {
    margin-top: 5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .scroll-line {
    width: 32px;
    height: 1px;
    background: var(--border-hover);
    position: relative;
    overflow: hidden;
  }
  /* Animating `left` relayouts the hero on every frame of a loop that never
     stops; the same travel as a transform stays on the compositor. */
  .scroll-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--text-2);
    will-change: transform;
    animation: scan 2.4s ease-in-out infinite;
  }
  @keyframes scan {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after {
      animation: none;
    }
  }

  /* ── ABOUT STRIP ──────────────────────────────────────────── */
  .about-strip {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-text {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.75;
  }
  .about-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--text-3);
    transition: color var(--t-fast);
  }
  .about-more:hover {
    color: var(--text-1);
  }
  .about-more svg {
    transition: transform var(--t-fast);
  }
  .about-more:hover svg {
    transform: translateX(3px);
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── WORK ─────────────────────────────────────────────────── */
  .work-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  .section-link:hover {
    color: var(--text-1);
  }
  .section-link svg {
    transition: transform var(--t-fast);
  }
  .section-link:hover svg {
    transform: translateX(3px);
  }

  /* One line each: the full write-ups live on /projects */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
  }
  .work-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .work-cat {
    color: var(--hue);
  }
  .work-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text-1);
  }
  .work-summary {
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-2);
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }

  /* ── SELECTED RESEARCH ────────────────────────────────────── */
  .research-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
  }
  .research-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .research-row {
    border-bottom: 1px solid var(--border);
  }
  .research-link {
    display: block;
    padding: 1.4rem 0;
  }
  .research-meta {
    display: block;
    color: var(--text-3);
    margin-bottom: 0.5rem;
  }
  .research-type {
    color: var(--hue);
  }
  .research-sep {
    margin: 0 0.5rem;
    color: var(--border-hover);
  }
  .research-title {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text-1);
    max-width: 62ch;
    margin-bottom: 0.4rem;
    transition: color var(--t-fast);
  }
  .research-link:hover .research-title {
    color: var(--hue);
  }
  .research-authors {
    font-size: 0.82rem;
    color: var(--text-3);
  }

  /* ── PHILOSOPHY ───────────────────────────────────────────── */
  .philosophy-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* top rule anchors the columns visually */
    border-top: 1px solid var(--border-hover);
    margin-bottom: 3.5rem;
  }

  /* All columns: top padding creates breathing room from the anchor rule */
  .phil-item {
    padding: 2rem 2.5rem 2.5rem 0;
  }

  /* Columns 2–4: left border as separator + matching left padding */
  .phil-item + .phil-item {
    border-left: 1px solid var(--border);
    padding-left: 2.5rem;
  }

  /* Last column: remove right padding so it sits flush */
  .phil-item:last-child {
    padding-right: 0;
  }

  .phil-word {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin-bottom: 0.75rem;
  }
  .phil-desc {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.7;
  }
  .phil-rule {
    display: none;
  } /* no longer needed — top-border handles alignment */

  .phil-quote {
    max-width: 620px;
    font-size: clamp(1.05rem, 2.5vw, 1.4rem);
    font-weight: 400;
    color: var(--text-2);
    line-height: 1.6;
    padding-left: 1.5rem;
    border-left: 2px solid var(--border-hover);
  }
  .phil-quote em {
    color: var(--text-1);
    font-style: italic;
  }
  .phil-quote-mark {
    display: none;
  }

  /* ── WRITING ──────────────────────────────────────────────── */
  .writing-section {
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
    border-top: 1px solid var(--border);
  }
  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    transition: all var(--t-fast);
    cursor: pointer;
  }
  .post-row:first-child {
    border-top: 1px solid var(--border);
  }
  .post-row:hover .post-title {
    color: var(--text-1);
  }
  .post-row:hover .post-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .post-row-left {
    flex: 1;
  }
  .post-date {
    display: block;
    margin-bottom: 0.4rem;
  }
  .post-title {
    font-size: 0.97rem;
    font-weight: 500;
    color: var(--text-2);
    line-height: 1.45;
    margin-bottom: 0.4rem;
    transition: color var(--t-fast);
  }
  .post-excerpt {
    font-size: 0.82rem;
    color: var(--text-3);
    line-height: 1.6;
  }
  .post-arrow {
    flex-shrink: 0;
