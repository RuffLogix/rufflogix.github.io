---
import FormalLayout from "../../layouts/FormalLayout.astro";
import {
  educationalInformation,
  experienceInformation,
  personalInfo,
} from "../../constants/timeline.constant";
import { techStackData } from "../../constants/techstack.constant";
import { events } from "../../constants/event.constant";
import { orgHue } from "../../utils/hue";

import AffiliationStrip from "../../components/AffiliationStrip.astro";

// Most recent first. Supports year ranges like "2022–2025" by sorting on the
// latest 4-digit year found in the string.
const latestYear = (y: string) =>
  Math.max(...(y.match(/\d{4}/g)?.map(Number) ?? [0]));
const activities = [...events].sort(
  (a, b) => latestYear(b.year) - latestYear(a.year),
);

const contactLinks = [
  { label: personalInfo.email, href: `mailto:${personalInfo.email}` },
  { label: "Google Scholar", href: personalInfo.scholar },
  { label: "GitHub", href: personalInfo.github },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/teejuta-sriwaranon/" },
  { label: "Kaggle", href: personalInfo.kaggle },
  { label: "Codeforces", href: personalInfo.codeforces },
];
---

<FormalLayout title="About | RuffLogix">
  <div class="about-page page-wrap">

    <!-- Page header -->
    <header class="about-header">
      <div class="about-header-grid">
        <!-- Left: text -->
        <div class="about-header-text">
          <h1 class="page-title">Software engineer, AI researcher.</h1>
          <p class="about-intro">
            Publishing on computer graphics, medical imaging AI, and formal
            verification, and building the production systems those ideas run
            on. Based in Bangkok, Thailand.
          </p>
          <p class="about-intro">
            Open to collaborations, research projects, and interesting problems.
          </p>

          <ul class="contact-links">
            {contactLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-link"
                  {...(href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: portrait -->
        <div class="about-photo-wrap">
          <div class="about-photo-frame">
            <img
              src="/images/latest-profile.jpeg"
              alt="Teejuta Sriwaranon (RuffLogix)"
              class="about-photo"
              width="533"
              height="800"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- ── EXPERIENCE ──────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title section-label">Experience</h2>

      <div class="timeline">
        {experienceInformation.map((exp) => (
          <div class="tl-item reveal"
               data-hue={orgHue(exp.instituteName)}>
            <div class="tl-left">
              <span class="tl-duration label">{exp.duration}</span>
            </div>
            <div class="tl-right">
              <div class="tl-org">
                <img src={exp.image} alt={exp.instituteName}
                     class="tl-logo" width="28" height="28" loading="lazy" />
                <div>
                  <h3 class="tl-name">
                    {exp.link ? (
                      <a href={exp.link} target="_blank" rel="noopener noreferrer" class="tl-link">
                        {exp.instituteName}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                          <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                      </a>
                    ) : exp.instituteName}
                  </h3>
                  {!exp.positions && <p class="tl-role">{exp.program}</p>}
                </div>
              </div>

              {exp.positions ? (
                <div class="tl-positions">
                  {exp.positions.map((pos) => (
                    <div class="tl-position">
                      <p class="tl-position-role">{pos.program}</p>
                      <span class="tl-position-duration label">{pos.duration}</span>
                      <p class="tl-desc">{pos.description}</p>
                    </div>
                  ))}
                </div>
              ) : exp.description ? (
                <p class="tl-desc">{exp.description}</p>
              ) : null}

              <span class="tl-location label">{exp.location}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── PART-TIME ROLES ─────────────────────────────────────── -->
    <AffiliationStrip wrap={false} border="top" />

    <!-- ── EDUCATION ───────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title section-label">Education</h2>

      <div class="timeline">
        {educationalInformation.map((edu) => (
          <div class="tl-item reveal"
               data-hue={orgHue(edu.instituteName)}>
            <div class="tl-left">
              <span class="tl-duration label">{edu.duration}</span>
            </div>
            <div class="tl-right">
              <div class="tl-org">
                <img src={edu.image} alt={edu.instituteName}
                     class="tl-logo" width="28" height="28" loading="lazy" />
                <div>
                  <h3 class="tl-name">{edu.instituteName}</h3>
                  <p class="tl-role">{edu.program}</p>
                </div>
              </div>
              <p class="tl-desc">{edu.description}</p>
              {edu.research && (
                <p class="tl-desc">
                  Undergraduate researcher in the{" "}
                  <a href={edu.research.labLink} target="_blank" rel="noopener noreferrer" class="text-link">{edu.research.lab}</a>,
                  advised by{" "}
                  <a href={edu.research.advisorLink} target="_blank" rel="noopener noreferrer" class="text-link">{edu.research.advisor}</a>,
                  working on {edu.research.topic}.
                </p>
              )}
              {edu.coursework && (
                <div class="tl-coursework">
                  <span class="tl-coursework-label label">Selected coursework</span>
                  <div class="cw-grid">
                    {edu.coursework.map((group) => (
                      <div class="cw-group">
                        <span class="cw-area label">{group.area}</span>
                        <p class="cw-courses">{group.courses.join(" · ")}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <span class="tl-location label">{edu.location}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── AWARDS & ACTIVITIES ─────────────────────────────────── -->
    <section class="section" id="activities">
      <h2 class="section-title section-label">Awards &amp; Activities</h2>

      <ol class="activity-list">
        {activities.map((ev) => (
          <li class="activity reveal">
            <span class="activity-year">{ev.year}</span>
            <span class="activity-main">
              <span class="activity-name">
                {ev.link ? (
                  <a href={ev.link} target="_blank" rel="noopener noreferrer" class="text-link">{ev.title}</a>
                ) : ev.title}
              </span>
              <span class="activity-org">
                {ev.organization ? `${ev.type}, ${ev.organization}` : ev.type}
              </span>
            </span>
            {(ev.award ?? ev.role) && (
              <span class="activity-result">{ev.award ?? ev.role}</span>
            )}
          </li>
        ))}
      </ol>
    </section>

    <!-- ── SKILLS ──────────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title section-label">Technical Skills</h2>

      <dl class="skills">
        {techStackData.map((cat) => (
          <div class="skill-row">
            <dt class="label">{cat.category}</dt>
            <dd>{cat.technologies.map((t) => t.name).join(", ")}</dd>
          </div>
        ))}
      </dl>
    </section>

  </div>
</FormalLayout>

<style>
.about-page {
  padding-top: clamp(2.5rem, 7vh, 4.5rem);
  padding-bottom: var(--sp-section);
}

/* ── HEADER ───────────────────────────────────────────────── */
.about-header { margin-bottom: 3rem; }

.about-header-grid {
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: 3.5rem;
  align-items: start;
}

.about-intro {
  font-size: 1.05rem;
  color: var(--text-2);
  max-width: 56ch;
  line-height: 1.6;
  margin-bottom: 0.9rem;
}

.contact-links {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.25rem;
  margin-top: 1.25rem;
  font-size: 0.95rem;
}

/* Photo */
.about-photo {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--r-md);
}

/* Sections */
.section {
  padding: 2.5rem 0;
  border-top: 1px solid var(--border);
}
.section-label { margin-bottom: 1rem; }

/* Timeline */
.timeline { display: flex; flex-direction: column; gap: 0; }

.tl-item {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 2rem;
  padding: 1.4rem 0;
  border-bottom: 1px solid var(--border);
}
.tl-item:last-child { border-bottom: none; }

.tl-left { padding-top: 0.15rem; }
.tl-duration {
  color: var(--hue);
  line-height: 1.5;
}

.tl-org {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 0.8rem;
}
.tl-logo {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  object-fit: contain;
  background: var(--bg-3);
  padding: 2px;
  flex-shrink: 0;
  margin-top: 2px;
  /* the ring carries the org's hue, so each logo is colour-anchored */
  border: 1px solid var(--hue-line, var(--border));
}
.tl-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 0.2rem;
  letter-spacing: -0.01em;
}
.tl-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  color: var(--text-1);
  transition: color var(--t-fast);
}
.tl-link:hover { color: var(--hue); }
.tl-role {
  font-size: 0.82rem;
  color: var(--text-2);
  font-weight: 500;
}
.tl-desc {
  font-size: 0.95rem;
  color: var(--text-2);
  line-height: 1.6;
  max-width: 72ch;
  margin-bottom: 0.6rem;
}
.tl-location { color: var(--text-3); }

/* Nested positions within one company — dot + connector rail */
.tl-positions {
  display: flex;
  flex-direction: column;
  margin: 0.1rem 0 0.85rem;
}

.tl-position {
  position: relative;
  padding-left: 1.4rem;
  padding-bottom: 1.5rem;
}
.tl-position:last-child { padding-bottom: 0; }

/* node */
.tl-position::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.32rem;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-3);
}
/* rail connecting this node to the next */
.tl-position::after {
  content: "";
  position: absolute;
  left: 3px;
  top: 1.05rem;
  bottom: 0.15rem;
  width: 1px;
  background: var(--border);
}
.tl-position:last-child::after { display: none; }

.tl-position-role {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: -0.01em;
  line-height: 1.4;
}
.tl-position-duration {
  display: block;
  color: var(--text-3);
  margin: 0.15rem 0 0.5rem;
}
.tl-position .tl-desc { margin-bottom: 0; }

.tl-coursework {
  margin-bottom: 0.9rem;
  max-width: 62ch;
}
.tl-coursework-label {
  display: block;
  color: var(--text-2);
  margin-bottom: 0.75rem;
}

.cw-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem 2rem;
}
.cw-area {
  display: block;
  color: var(--text-3);
  margin-bottom: 0.3rem;
}
.cw-courses {
  font-size: 0.875rem;
  color: var(--text-2);
  line-height: 1.6;
}

@media (max-width: 768px) {
  .cw-grid {
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }
}

/* Awards & activities: one dense line each, the academic convention */
.activity-list { list-style: none; border-top: 1px solid var(--border); }
.activity {
  display: grid;
  grid-template-columns: 6rem minmax(0, 1fr) auto;
  gap: 1rem;
  align-items: baseline;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--border);
}
.activity-year {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
.activity-name { display: block; font-size: 0.95rem; font-weight: 500; color: var(--text-1); }
.activity-org { display: block; font-size: 0.85rem; color: var(--text-3); }
.activity-result { font-size: 0.875rem; color: var(--text-1); text-align: right; }

/* Skills read as a list of facts, not a wall of pills */
.skills { border-top: 1px solid var(--border); }
.skill-row {
  display: grid;
  grid-template-columns: 11rem minmax(0, 1fr);
  gap: 1rem;
  align-items: baseline;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--border);
}
.skill-row dd { font-size: 0.95rem; color: var(--text-2); line-height: 1.55; }

/* Responsive */
@media (max-width: 960px) {
  .about-header-grid { grid-template-columns: 1fr 200px; gap: 2rem; }
}

@media (max-width: 768px) {
  .tl-item  { grid-template-columns: 110px 1fr; gap: 1.25rem; }
}

@media (max-width: 640px) {
  .about-header-grid { grid-template-columns: 1fr; }
  /* Who this is comes first; the photo follows at a modest size */
  .about-photo-wrap { max-width: 180px; }
  .contact-links a { display: inline-block; padding: 0.35rem 0; }

  .tl-item       { grid-template-columns: 1fr; gap: 0.35rem; }
  .tl-left       { padding-top: 0; }
  .tl-duration   { display: block; margin-bottom: 0.5rem; }

  .activity      { grid-template-columns: minmax(0, 1fr) auto; gap: 0.1rem 1rem; }
  .activity-year { grid-column: 1 / -1; }
  .skill-row     { grid-template-columns: 1fr; gap: 0.15rem; }
}
</style>
