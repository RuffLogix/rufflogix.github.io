---
import FormalLayout from "../../layouts/FormalLayout.astro";
import { publicationInformation } from "../../constants/publication.constant";
import { personalInfo } from "../../constants/timeline.constant";
import { isSelfAuthor, toBibtex } from "../../utils/citation";
---

<FormalLayout title="Publications | RuffLogix">
  <div class="pubs-page page-wrap">
    <!-- Page header -->
    <header class="pubs-header">
      <h1 class="page-title">Publications</h1>
      <p class="page-sub">
        Published, accepted, and preprint work across computer graphics, medical
        imaging AI, speech and language processing, and formal verification.
      </p>

      <!-- Profile and bulk-citation links, where academic readers expect them -->
      <div class="pubs-actions">
        <a
          href={personalInfo.scholar}
          target="_blank"
          rel="noopener noreferrer"
          class="pubs-action"
        >
          Google Scholar
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="7" y1="17" x2="17" y2="7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
        <a href="/rufflogix.bib" download class="pubs-action">
          Download BibTeX
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v12" />
            <polyline points="7 10 12 15 17 10" />
            <path d="M5 21h14" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Publication index -->
    <ol class="pubs-index">
      {
        publicationInformation.map((p, i) => (
          <li class="pub-row reveal" id={`pub-${i + 1}`} data-hue="research">
            <span class="pub-num">{String(publicationInformation.length - i).padStart(2, "0")}</span>

            <div class="pub-body">
              <h2 class="pub-title">
                {p.doiLink ? (
                  <a
                    href={p.doiLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pub-title-link"
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h2>

              <p class="pub-authors">
                {p.authors.map((a, idx) => (
                  // The comma sits inside the span so the gap between authors is
                  // the markup's own whitespace, not whitespace plus a comma.
                  <span
                    class:list={[
                      "pub-author",
                      { self: isSelfAuthor(idx, p.selfAuthorIndex) },
                    ]}
                  >
                    {idx < p.authors.length - 1 ? `${a},` : a}
                  </span>
                ))}
              </p>

              <p class="pub-venue">
                {/* Conference names already open with their year */}
                {p.venue.includes(p.date) ? p.venue : `${p.venue}, ${p.date}`}
              </p>

              <p class="pub-meta">
                <span class="pub-type">{p.type}</span>
                {p.status === "accepted" && <span class="pub-status">Accepted, to appear</span>}
                {p.area && <span>{p.area}</span>}
              </p>

              <div class="pub-actions">
                {p.doi && (
                  p.doiLink ? (
                    <a href={p.doiLink} target="_blank" rel="noopener noreferrer" class="pub-link">
                      DOI: {p.doi}
                    </a>
                  ) : (
                    <span class="pub-link pub-link-static">DOI: {p.doi}</span>
                  )
                )}
                {p.pdfLink && (
                  <a href={p.pdfLink} target="_blank" rel="noopener noreferrer" class="pub-link">
                    PDF
                  </a>
                )}
                {p.codeLink && (
                  <a href={p.codeLink} target="_blank" rel="noopener noreferrer" class="pub-link">
                    Code
                  </a>
                )}
                {p.abstract && (
                  <details class="pub-more">
                    <summary class="pub-toggle">Abstract</summary>
                    <div class="pub-panel">
                      <p class="pub-abstract">{p.abstract}</p>
                      {p.tags.length > 0 && (
                        <p class="pub-keywords">Keywords: {p.tags.join(", ")}</p>
                      )}
                    </div>
                  </details>
                )}
                <details class="pub-more">
                  <summary class="pub-toggle">BibTeX</summary>
                  <div class="pub-panel cite-box">
                    <pre class="cite-pre" tabindex="0">{toBibtex(p)}</pre>
                    <button type="button" class="cite-copy">Copy</button>
                  </div>
                </details>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Empty state -->
    {
      publicationInformation.length === 0 && (
        <div class="empty-state">
          <p class="label">Publications coming soon</p>
        </div>
      )
    }
  </div>
</FormalLayout>

<style>
  .pubs-page {
    padding-top: clamp(2.5rem, 7vh, 4.5rem);
    padding-bottom: var(--sp-section);
  }

  .pubs-header {
    margin-bottom: 2rem;
  }
  .pubs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
  }
  .pubs-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-1);
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-hover);
    border-radius: var(--r-sm);
    transition: background var(--t-fast);
  }
  .pubs-action:hover {
    background: var(--surface-hover);
  }

  /* ── Index: number in the margin, paper-style ────────────── */
  .pubs-index {
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .pub-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
    transition: background var(--t-slow) var(--expo);
  }
  /* Arriving from a homepage link: show which entry was meant */
  .pub-row:target {
    background: var(--hue-soft);
    box-shadow: -0.75rem 0 0 var(--hue-soft), 0.75rem 0 0 var(--hue-soft);
  }

  .pub-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.9;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .pub-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-1);
    max-width: 62ch;
    margin-bottom: 0.4rem;
  }
  .pub-title-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-fast);
  }
  .pub-title-link:hover {
    text-decoration-color: currentColor;
  }

  .pub-authors {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.5;
  }
  .pub-author.self {
    color: var(--text-1);
    font-weight: 600;
  }
  .pub-venue {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-2);
    line-height: 1.5;
    margin-top: 0.1rem;
    max-width: 72ch;
  }

  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .pub-type {
    color: var(--hue);
  }
  .pub-status {
    color: var(--text-1);
  }

  /* Links and toggles share one row; an open toggle takes a line of its own */
  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.1rem;
    margin-top: 0.55rem;
    font-size: 0.875rem;
  }
  .pub-link,
  .pub-toggle {
    color: var(--text-1);
    text-decoration: underline;
    text-decoration-color: var(--border-hover);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-fast);
  }
  .pub-link:hover,
  .pub-toggle:hover {
    text-decoration-color: currentColor;
  }
  .pub-link-static {
    text-decoration: none;
    color: var(--text-2);
  }

  .pub-more[open] {
    flex-basis: 100%;
  }
  .pub-toggle {
    display: inline-flex;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
  }
  .pub-toggle::-webkit-details-marker {
    display: none;
  }
  .pub-toggle::before {
    content: "+";
    font-family: var(--font-mono);
  }
  .pub-more[open] > .pub-toggle::before {
    content: "−";
  }
  .pub-panel {
    margin: 0.6rem 0 0.4rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border-hover);
  }
  .pub-abstract {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 72ch;
  }
  .pub-keywords {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .cite-pre {
    /* Long DOIs and titles scroll rather than stretching the page */
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--text-2);
    white-space: pre;
  }
  .cite-copy {
    margin-top: 0.5rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-hover);
    border-radius: var(--r-sm);
    font-size: 0.8rem;
    color: var(--text-1);
    transition: background var(--t-fast);
  }
  .cite-copy:hover {
    background: var(--surface-hover);
  }

  /* Empty */
  .empty-state {
    padding: 4rem 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .pub-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .pub-title {
      font-size: 1.15rem;
    }
    .pub-link,
    .pub-toggle {
      display: inline-block;
      padding: 0.3rem 0;
    }
    .pub-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const RESET_MS = 1600;

  document.querySelectorAll<HTMLButtonElement>(".cite-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pre = btn.closest(".cite-box")?.querySelector("pre");
      const bibtex = pre?.textContent;
      if (!pre || !bibtex) return;

      try {
        await navigator.clipboard.writeText(bibtex);
        btn.textContent = "Copied";
      } catch {
        // Clipboard API is unavailable outside a secure context — select the
        // entry instead so the keyboard shortcut still works.
        const range = document.createRange();
        range.selectNodeContents(pre);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        btn.textContent = "Selected";
      }

      window.setTimeout(() => {
        btn.textContent = "Copy";
      }, RESET_MS);
    });
  });
</script>
