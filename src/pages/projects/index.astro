---
import FormalLayout from "../../layouts/FormalLayout.astro";
import { projectInformation } from "../../constants/project.constant";
import { projectHue } from "../../utils/hue";
import {
  projectLinks,
  projectMonth,
  projectSummary,
  projectYear,
} from "../../utils/project";

// Categories in first-appearance order, each with its own count.
const categories = [...new Set(projectInformation.map((p) => p.category))].map(
  (name) => ({
    name,
    count: projectInformation.filter((p) => p.category === name).length,
  }),
);

// The list is already sorted newest first, so grouping keeps that order.
const years = [...new Set(projectInformation.map(projectYear))].map((year) => ({
  year,
  projects: projectInformation.filter((p) => projectYear(p) === year),
}));

// Most entries are personal projects, so only the exceptions are worth a label.
const roleLabel = (role: string) =>
  role === "Personal Project" || role === "Project" ? null : role;

const total = projectInformation.length;
---

<FormalLayout title="Work | RuffLogix">
  <div class="projects-page page-wrap">
    <header class="projects-header">
      <h1 class="projects-title">Work</h1>
      <p class="page-sub">
        Systems built for performance, AI, and exploration.
      </p>
    </header>

    <div class="proj-filter">
      <div class="filter-chips" role="group" aria-label="Filter projects by category">
        <button
          type="button"
          class="chip is-active"
          data-filter="all"
          aria-pressed="true"
        >
          All <span class="chip-count">{total}</span>
        </button>
        {categories.map(({ name, count }) => (
          <button type="button" class="chip" data-filter={name} aria-pressed="false">
            {name} <span class="chip-count">{count}</span>
          </button>
        ))}
      </div>

      <p class="projects-count label" id="proj-count" aria-live="polite">
        {total} projects
      </p>
    </div>

    <div class="proj-years">
      {
        years.map(({ year, projects }) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 class="year-label" id={`year-${year}`}>{year}</h2>

            <ol class="proj-list">
              {projects.map((p) => {
                const links = projectLinks(p);
                const summary = projectSummary(p);
                const role = roleLabel(p.role);
                const month = projectMonth(p);
                return (
                  <li
                    class="proj-row reveal"
                    data-category={p.category}
                    data-hue={projectHue(p.category)}
                  >
                    <div class="proj-main">
                      <h3 class="proj-title">
                        {links[0] ? (
                          <a
                            href={links[0].url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {p.title}
                          </a>
                        ) : (
                          p.title
                        )}
                      </h3>
                      <p class="proj-summary">{summary}</p>
                    </div>

                    <div class="proj-side">
                      {links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-link"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>

                    <div class="proj-foot">
                      <p class="proj-meta label">
                        <span class="proj-cat">{p.category}</span>
                        {month && <span>{month}</span>}
                        {role && <span>{role}</span>}
                        {p.status && <span class="proj-status">{p.status}</span>}
                      </p>
                      <details class="proj-details">
                        <summary class="proj-toggle">Details</summary>
                        <div class="proj-panel">
                          {p.description !== summary && (
                            <p class="proj-desc">{p.description}</p>
                          )}
                          <p class="proj-stack">{p.tags.join(" · ")}</p>
                        </div>
                      </details>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }
    </div>

    {
      total === 0 && (
        <div class="empty-state">
          <p class="label">More projects coming soon</p>
        </div>
      )
    }
  </div>
</FormalLayout>

<script>
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]"),
  );
  const rows = Array.from(
    document.querySelectorAll<HTMLLIElement>(".proj-row[data-category]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>(".year-group"),
  );
  const countEl = document.getElementById("proj-count");

  function applyFilter(filter: string) {
    let shown = 0;

    rows.forEach((row) => {
      const match = filter === "all" || row.dataset.category === filter;
      row.hidden = !match;
      if (match) shown++;
    });

    // A year with nothing left in it shouldn't leave a bare heading behind
    groups.forEach((group) => {
      group.hidden = !group.querySelector(".proj-row:not([hidden])");
    });

    chips.forEach((chip) => {
      const active = chip.dataset.filter === filter;
      chip.classList.toggle("is-active", active);
      chip.setAttribute("aria-pressed", String(active));
    });

    if (countEl) countEl.textContent = `${shown} ${shown === 1 ? "project" : "projects"}`;
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => applyFilter(chip.dataset.filter ?? "all")),
  );
</script>

<style>
  .projects-page {
    padding-top: clamp(3rem, 9vh, 5.5rem);
    padding-bottom: var(--sp-section);
  }

  /* Same voice as the homepage hero, one step down */
  .projects-header {
    margin-bottom: 2.25rem;
  }
  .projects-title {
    font-size: clamp(2.75rem, 1.5rem + 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text-1);
    margin-bottom: 0.75rem;
  }

  /* ── Filter bar ──────────────────────────────────────────── */
  .proj-filter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--border-hover);
    font-size: 0.85rem;
    color: var(--text-2);
    transition:
      border-color var(--t-fast),
      color var(--t-fast),
      background var(--t-fast);
  }
  .chip:hover {
    color: var(--text-1);
    background: var(--surface-hover);
  }
  /* Active is inverted ink: state, not category, so it carries no hue */
  .chip.is-active {
    border-color: var(--text-1);
    background: var(--text-1);
    color: var(--bg);
  }
  .chip-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .projects-count {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── Years: the year holds its place while its projects scroll by ── */
  .year-group {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--border-hover);
    padding-bottom: 2rem;
  }
  .year-group[hidden] {
    display: none;
  }
  .year-label {
    position: sticky;
    top: calc(var(--nav-h) + 1rem);
    align-self: start;
    padding-top: 1.2rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  /* ── Rows ────────────────────────────────────────────────── */
  .proj-list {
    list-style: none;
  }
  .proj-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 2rem;
    padding: 1.1rem 0;
  }
  .proj-row + .proj-row {
    border-top: 1px solid var(--border);
  }
  .proj-row[hidden] {
    display: none;
  }

  .proj-title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--text-1);
    margin-bottom: 0.25rem;
  }
  .proj-title a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-fast);
  }
  .proj-title a:hover {
    text-decoration-color: currentColor;
  }
  .proj-summary {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 72ch;
  }
  /* Meta and the toggle share a line; an open panel takes a line of its own */
  .proj-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.25rem;
  }
  .proj-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
  }
  .proj-cat {
    color: var(--hue);
  }
  .proj-status {
    color: var(--text-1);
  }

  .proj-side {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: flex-start;
    gap: 0.25rem 1rem;
    max-width: 14rem;
    padding-top: 0.2rem;
    font-size: 0.875rem;
  }

  /* ── Details ─────────────────────────────────────────────── */
  .proj-details[open] {
    flex-basis: 100%;
    min-width: 0;
  }
  .proj-toggle {
    display: inline-flex;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  .proj-toggle:hover {
    color: var(--text-1);
  }
  .proj-toggle::-webkit-details-marker {
    display: none;
  }
  .proj-toggle::before {
    content: "+";
    font-family: var(--font-mono);
  }
  .proj-details[open] > .proj-toggle::before {
    content: "−";
  }
  .proj-panel {
    margin-top: 0.6rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border-hover);
  }
  .proj-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 72ch;
    margin-bottom: 0.5rem;
  }
  .proj-stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-3);
  }

  .empty-state {
    padding: 4rem 0;
    text-align: center;
  }

  @media (max-width: 720px) {
    .year-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    /* On a narrow screen a pinned year would cover the row it labels */
    .year-label {
      position: static;
      padding-top: 1rem;
    }
    .proj-row {
      grid-template-columns: minmax(0, 1fr);
      padding: 1rem 0;
    }
    .proj-side {
      justify-content: flex-start;
      max-width: none;
      padding-top: 0;
    }
    .proj-side a,
    .proj-toggle {
      padding: 0.3rem 0;
    }
  }
</style>
