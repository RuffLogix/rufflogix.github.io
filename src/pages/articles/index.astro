---
import FormalLayout from "../../layouts/FormalLayout.astro";
import {
  getPosts,
  MEDIUM_PROFILE,
  postDate,
  postExcerpt,
  postTitle,
} from "../../utils/medium";

const posts = await getPosts();
---

<FormalLayout title="Writing | RuffLogix">
  <div class="articles-page page-wrap">

    <header class="articles-header">
      <h1 class="page-title">Writing</h1>
      <p class="page-sub">
        Technical writing, in English and Thai, published on
        <a href={MEDIUM_PROFILE} target="_blank" rel="noopener noreferrer" class="text-link">Medium</a>.
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map((post) => {
          const image = post.image;
          return (
          <a href={post.url} target="_blank" rel="noopener noreferrer"
             class="post-row reveal">
            {image && (
              <div class="post-thumb-wrap">
                <img
                  src={image}
                  alt=""
                  loading="lazy"
                  class="post-thumb"
                  onerror="this.closest('.post-thumb-wrap').remove()"
                />
              </div>
            )}
            <div class="post-row-inner">
              <div class="post-meta-row">
                <span class="label post-date">{postDate(post)}</span>
              </div>
              <h2 class="post-title">{postTitle(post)}</h2>
              <p class="post-excerpt">{postExcerpt(post, 180)}</p>
            </div>
            <div class="post-arrow-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </a>
          );
        })}
      </div>
    ) : (
      <div class="empty-state reveal">
        <p class="empty-copy">Posts couldn't be loaded when this page was built. They're all on Medium.</p>
        <a href={MEDIUM_PROFILE} target="_blank" rel="noopener noreferrer"
           class="btn btn-ghost" style="margin-top: 1rem;">
          Read on Medium
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</FormalLayout>

<style>
.articles-page {
  padding-top: clamp(2.5rem, 7vh, 4.5rem);
  padding-bottom: var(--sp-section);
}

.articles-header { margin-bottom: 2rem; }

.posts-list { display: flex; flex-direction: column; }

.post-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.75rem 0;
  border-bottom: 1px solid var(--border);
  transition: all var(--t-fast);
  cursor: pointer;
}
.post-row:first-child { border-top: 1px solid var(--border); }
.post-row:hover .post-title { color: var(--text-1); }
.post-row:hover .post-arrow-wrap { opacity: 1; transform: translateX(0); }

.post-thumb-wrap {
  flex-shrink: 0;
  width: 140px;
  aspect-ratio: 16 / 10;
  border-radius: 8px;
  overflow: hidden;
  background: var(--border);
}
.post-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--t-mid) var(--expo);
}
.post-row:hover .post-thumb { transform: scale(1.04); }

.post-row-inner { flex: 1; }
.post-meta-row { margin-bottom: 0.5rem; }
.post-date { color: var(--text-3); }

.post-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.45;
  margin-bottom: 0.5rem;
  letter-spacing: -0.01em;
  transition: color var(--t-fast);
}
.post-excerpt {
  font-size: 0.85rem;
  color: var(--text-2);
  line-height: 1.7;
}

.post-arrow-wrap {
  flex-shrink: 0;
  color: var(--text-3);
  opacity: 0.4;
  transform: translateX(-4px);
  transition: all var(--t-mid) var(--expo);
  margin-top: 0.2rem;
}

.empty-copy { font-size: 1rem; color: var(--text-2); }
.empty-state {
  padding: 1rem 0 2rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

@media (max-width: 640px) {
  .articles-header { margin-bottom: 2.5rem; }
  .post-row { padding: 1.25rem 0; gap: 1rem; }
  .post-title { font-size: 0.95rem; }
  .post-arrow-wrap { flex-shrink: 0; }
  .post-thumb-wrap { width: 84px; }
}
</style>
