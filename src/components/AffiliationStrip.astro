---
import { affiliationInformation } from "../constants/affiliation.constant";
import { orgHue } from "../utils/hue";

interface Props {
  /** Wrap in `page-wrap` — off when the parent already provides the gutter. */
  wrap?: boolean;
  /** Which edge carries the hairline rule, so the strip can sit between
      sections that own their own borders without doubling up. */
  border?: "top" | "bottom" | "none";
}

const { wrap = true, border = "bottom" } = Astro.props;

// Current roles lead, past roles follow under their own heading. Empty groups
// drop out entirely, so the list reads correctly whether or not a part-time
// role is running right now.
const groups = [
  {
    label: "Current",
    current: true,
    items: affiliationInformation.filter((a) => a.current),
  },
  {
    label: "Previously",
    current: false,
    items: affiliationInformation.filter((a) => !a.current),
  },
].filter((g) => g.items.length > 0);

// With both kinds present the section needs a neutral heading and per-group
// labels; with only one kind the group label is the heading, and repeating it
// twice would be noise.
const heading =
  groups.length > 1
    ? "Part-Time Roles"
    : groups[0]?.current
      ? "Current Part-Time Roles"
      : "Previous Part-Time Roles";
---

{
  groups.length > 0 && (
    <section
      class:list={[
        "affiliations-section",
        wrap && "page-wrap",
        `border-${border}`,
      ]}
    >
      <p class="label-strong reveal affiliations-label">{heading}</p>

      {groups.map((group) => (
        <div class="pt-group">
          {groups.length > 1 && (
            <p class="pt-group-label label reveal">{group.label}</p>
          )}
          <ul class="pt-list">
            {group.items.map((org, i) => {
              // `a` when there is somewhere to go, `div` otherwise — keeps a
              // single copy of the row markup instead of two near-identical
              // branches.
              const Row = org.link ? "a" : "div";
              return (
                <li
                  class:list={["pt-item reveal", `d${(i % 4) + 1}`]}
                  data-hue={orgHue(org.name)}
                >
                  <Row
                    class="pt-row"
                    {...(org.link
                      ? {
                          href: org.link,
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                  >
                    <img
                      src={org.image}
                      alt=""
                      class="pt-logo"
                      width="28"
                      height="28"
                      loading="lazy"
                    />
                    <span class="pt-org">
                      {org.name}
                      {org.link && (
                        <svg
                          class="pt-ext"
                          width="10"
                          height="10"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      )}
                    </span>
                    <span class="pt-role">{org.position}</span>
                    <span class="pt-period label">
                      {org.current && <span class="pt-dot" aria-hidden="true" />}
                      {org.period}
                    </span>
                  </Row>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  )
}

<style>
  .affiliations-section {
    padding-top: calc(var(--sp-section) * 0.7);
    padding-bottom: calc(var(--sp-section) * 0.7);
  }
  .border-bottom {
    border-bottom: 1px solid var(--border);
  }
  .border-top {
    border-top: 1px solid var(--border);
  }
  .affiliations-label {
    margin-bottom: 1.75rem;
  }

  .pt-group + .pt-group {
    margin-top: 2rem;
  }
  .pt-group-label {
    color: var(--text-3);
    margin-bottom: 0.75rem;
  }

  /* Equal-width cells on one grid, separated by space alone — the column rhythm
     is what holds the band together, so no rules are needed to draw it. */
  .pt-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* No hover panel: a filled box here has to either sit inside the cell, which
     crops it awkwardly against the text, or spill into the column gap and read
     as a card overlapping its neighbour. The mark and the name carry the
     hover state instead. */
  .pt-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    height: 100%;
  }

  /* These five marks disagree about everything — white grounds, a dark ground,
     five brand palettes. Putting them all on one constant light chip and
     draining the colour makes them read as a set; hover returns the real logo. */
  .pt-logo {
    width: 34px;
    height: 34px;
    margin-bottom: 0.5rem;
    border-radius: 8px;
    object-fit: contain;
    background: #f4f4f4;
    padding: 3px;
    /* Draining colour is enough to unify them; dropping opacity as well turned
       the smaller marks to mush, so the contrast bump replaces it. */
    filter: grayscale(1) contrast(1.08);
    opacity: 0.88;
    transition:
      filter var(--t-mid) var(--expo),
      opacity var(--t-mid) var(--expo);
  }
  a.pt-row:hover .pt-logo {
    filter: grayscale(0);
    opacity: 1;
  }

  .pt-org {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-1);
    white-space: nowrap;
    transition: color var(--t-fast);
  }
  a.pt-row:hover .pt-org {
    color: var(--hue, var(--text-1));
  }
  .pt-ext {
    opacity: 0;
    flex-shrink: 0;
    transition: opacity var(--t-fast);
  }
  a.pt-row:hover .pt-ext {
    opacity: 1;
  }

  /* Role in ink, period in mono beneath it — the name stays the loudest thing
     in the cell. */
  .pt-role {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-2);
  }
  .pt-period {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.1rem;
    font-size: 0.6rem;
    color: var(--text-3);
  }
  .pt-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hue, var(--text-2));
    flex-shrink: 0;
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-dot {
      animation: none;
    }
  }

  /* Column count steps down rather than letting cells crush; the lattice keeps
     working at every count because the clipping trick is count-agnostic. */
  @media (max-width: 1100px) {
    .pt-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .pt-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.5rem;
    }
  }
  @media (max-width: 460px) {
    .pt-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .pt-logo {
      width: 30px;
      height: 30px;
    }
  }
</style>
